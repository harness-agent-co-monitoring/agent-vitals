+"""Harness evolution loop for HANDBOOK.md.
+
+A sibling of terminal_bench_2/meta_harness.py with the same phases (baseline
+-> propose -> validate -> smoke -> benchmark -> frontier) and state files. The
+candidate is an agent harness around the benchmark's in-container OpenHands
+loop (agents/<name>.py, class AgentHarness(HandbookRunner)); the objective is
+the mean rubric score; search runs on one rule-variant per base handbook and
+the sibling variants are the holdout. Leak audits keep candidates and trials
+inside the benchmark's rules. With --vitals, a subsample of every benchmark is
+replayed through agent-vitals and the proposer gets a per-section read digest.
+
+    HB_ROOT=/path/to/handbook uv run python meta_harness.py --iterations 5
+    HB_ROOT=/path/to/handbook uv run python meta_harness.py --iterations 5 --vitals
+"""
+
+import argparse
+import functools
+import importlib
+import inspect
+import json
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+
+import claude_wrapper
+from dotenv import load_dotenv
+
+# ── ANSI colors ──────────────────────────────────────────────
+_USE_COLOR = sys.stdout.isatty()
+
+
+def _c(code, text):
+    return f"\033[{code}m{text}\033[0m" if _USE_COLOR else text
+
+
+def _bold(t):
+    return _c("1", t)
+
+
+def _dim(t):
+    return _c("2", t)
+
+
+def _green(t):
+    return _c("32", t)
+
+
+def _red(t):
+    return _c("31", t)
+
+
+def _yellow(t):
+    return _c("33", t)
+
+
+def _cyan(t):
+    return _c("36", t)
+
+
+def _ts():
+    """Short timestamp prefix."""
+    return _dim(datetime.now().strftime("[%H:%M:%S]"))
+
+
+def _elapsed(seconds):
+    """Format seconds as 1m23s or 45s."""
+    m, s = divmod(int(seconds), 60)
+    return f"{m}m{s:02d}s" if m else f"{s}s"
+
+
+def _rate_str(rate):
+    """Color-coded score."""
+    s = f"{rate:.0%}"
+    if rate >= 0.75:
+        return _green(s)
+    elif rate >= 0.25:
+        return _yellow(s)
+    return _red(s)
+
+
+load_dotenv(override=True)
+
+EVOLVE_DIR = Path(__file__).parent
+LOGS_DIR = EVOLVE_DIR / "logs"
+JOBS_DIR = EVOLVE_DIR / "jobs"
+PENDING_EVAL = LOGS_DIR / "pending_eval.json"
+FRONTIER_VAL = LOGS_DIR / "frontier_val.json"
+EVOLUTION_SUMMARY = LOGS_DIR / "evolution_summary.jsonl"
+VITALS_DIR = LOGS_DIR / "vitals"
+AGENTS_DIR = EVOLVE_DIR / "agents"
+
+BASELINES = [
+    ("openhands-baseline", "agents.baseline_openhands:AgentHarness"),
+]
+BASELINE_AGENT_NAME = BASELINES[0][0]  # primary baseline for frontier comparison
+
+# Task sets live in scripts/run_eval.sh: train = one rule-variant of each of the
+# ten base handbooks, holdout = the sibling variants, smoke = one train task.
+EVAL_TASK_SET = "train"
+N_EVAL_TASKS = 10
+HOLDOUT_TASK_SET = "holdout"
+HOLDOUT_TRIALS = 3
+
+MODEL = os.environ.get("HARBOR_MODEL", "openrouter/qwen/qwen3.6-27b")
+VITALS_PYTHON = os.environ.get("VITALS_PYTHON", sys.executable)
+LEAK_AUDIT_MODULE = "vitals.addons.metaharness.audit.handbook_leaks"
+DEFAULT_SEARCH_TRIALS = 2
+DEFAULT_CONCURRENCY = 8
+HARBOR_TIMEOUT_SECONDS = int(os.environ.get("HARBOR_TIMEOUT_SECONDS", 4 * 60 * 60))
+MAX_TOOL_CALLS = 200
+MAX_PROMPT_WORDS = 1500
+
+PROPOSER_ALLOWED_TOOLS = [
+    "Read",
+    "Glob",
+    "Grep",
+    "Agent",
+    "Write",
+    "Edit",
+    "Bash",
+]
