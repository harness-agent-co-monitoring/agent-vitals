+#!/usr/bin/env bash
+# Usage: scripts/run_eval.sh <agents/<name>.py> [train|holdout|smoke] [runs] [n_concurrent] [extra_harbor_flags...]
+# Benchmarks one harness candidate (class AgentHarness(HandbookRunner)) on a HANDBOOK.md
+# task set. candidate_agent.py uploads the candidate and handbook_runner.py into each task
+# container and runs them in the benchmark's own runner venv; --ak log_completions=true
+# keeps every LLM request and response in the trial's agent/completions/.
+
+set -euo pipefail
+
+CANDIDATE_FILE="${1:?Usage: $0 <agents/<name>.py> [task_set] [runs] [n_concurrent] [extra_harbor_flags...]}"
+TASK_SET="${2:-train}"
+RUNS="${3:-2}"
+N_CONCURRENT="${4:-8}"
+shift "$(( $# < 4 ? $# : 4 ))"
+EXTRA_FLAGS=("$@")
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(dirname "$SCRIPT_DIR")"
+export PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}"
+
+# Load local .env (override shell environment)
+if [[ -f "$REPO_DIR/.env" ]]; then
+    set -a
+    # shellcheck source=/dev/null
+    source "$REPO_DIR/.env"
+    set +a
+fi
+
+HB_ROOT="${HB_ROOT:?Set HB_ROOT to your HANDBOOK.md checkout}"
+HB_HARBOR="${HB_HARBOR:-$HB_ROOT/.venv/bin/harbor}"
+MODEL="${HARBOR_MODEL:-openrouter/qwen/qwen3.6-27b}"
+HARBOR_TIMEOUT_SECONDS="${HARBOR_TIMEOUT_SECONDS:-14400}"
+
+# Ten base handbooks, two rule-variants each: search on one variant per base,
+# hold out the sibling variant.
+TRAIN_TASKS=(
+    finance_meridian_partners_cc2fc143
+    finance_sunshine_set_b581c493
+    hr_crestwood_university_da394eac
+    hr_ridgeline_gear_co_6950ff2b
+    insurance_mojave_crest_assurance_company_4d2a2588
+    insurance_vanguard_shield_mutual_4321b8e9
+    logistics_gear_sytems_inc_74170ae1
+    logistics_prairie_star_creamery_27470081
+    medical_careig_specialty_pharmacy_ea622238
+    medical_pathfinder_billing_and_coding_a70deabc
+)
+HOLDOUT_TASKS=(
+    finance_meridian_partners_331accf1
+    finance_sunshine_set_6b9398f4
+    hr_crestwood_university_ee4d1791
+    hr_ridgeline_gear_co_6d4d0f70
+    insurance_mojave_crest_assurance_company_5122b4da
+    insurance_vanguard_shield_mutual_89007056
+    logistics_gear_sytems_inc_dba0375e
+    logistics_prairie_star_creamery_861b2650
+    medical_careig_specialty_pharmacy_f5947c33
+    medical_pathfinder_billing_and_coding_c01deb6e
+)
+
+case "$TASK_SET" in
+    train)   TASKS=("${TRAIN_TASKS[@]}") ;;
+    holdout) TASKS=("${HOLDOUT_TASKS[@]}") ;;
+    smoke)   TASKS=("${TRAIN_TASKS[0]}") ;;
+    *) echo "Unknown task_set '$TASK_SET'. Use: train | holdout | smoke" >&2; exit 1 ;;
+esac
+[[ -f "$CANDIDATE_FILE" ]] || { echo "candidate module not found: $CANDIDATE_FILE" >&2; exit 1; }
+[[ -x "$HB_HARBOR" ]] || { echo "harbor not found at $HB_HARBOR (set HB_HARBOR)" >&2; exit 1; }
+CANDIDATE_ABS="$(cd "$(dirname "$CANDIDATE_FILE")" && pwd)/$(basename "$CANDIDATE_FILE")"
+
+echo "candidate:   $CANDIDATE_ABS"
+echo "task_set:    $TASK_SET (${#TASKS[@]} tasks)"
+echo "model:       $MODEL"
+echo "concurrent:  $N_CONCURRENT"
+echo "runs:        $RUNS"
+echo "timeout:     ${HARBOR_TIMEOUT_SECONDS}s"
+echo ""
+
+TIMEOUT_CMD=()
+if [[ "${HARBOR_EXTERNAL_TIMEOUT:-0}" != "1" ]]; then
+    if command -v timeout >/dev/null 2>&1; then
+        TIMEOUT_CMD=(timeout --signal=TERM --kill-after=60 "$HARBOR_TIMEOUT_SECONDS")
+    elif command -v gtimeout >/dev/null 2>&1; then
+        TIMEOUT_CMD=(gtimeout --signal=TERM --kill-after=60 "$HARBOR_TIMEOUT_SECONDS")
+    fi
+fi
+
+CMD=(
+    "$HB_HARBOR" run
+    -p "$HB_ROOT/tasks"
+    --agent candidate_agent:CandidateAgent
+    -m "$MODEL"
+    -n "$N_CONCURRENT"
+    --n-attempts "$RUNS"
+    --ak log_completions=true
+    --ak "runner_file=$CANDIDATE_ABS"
+)
+for t in "${TASKS[@]}"; do CMD+=(-i "$t"); done
+if [[ -f "$HB_ROOT/.env" ]]; then
+    CMD+=(--env-file "$HB_ROOT/.env")
+fi
+if [[ -n "${HB_OPENROUTER_PROVIDER:-}" ]]; then
+    CMD+=(--ak "openrouter_provider=$HB_OPENROUTER_PROVIDER")
+fi
+if [[ ${#EXTRA_FLAGS[@]} -gt 0 ]]; then
+    CMD+=("${EXTRA_FLAGS[@]}")
+fi
+
+if [[ ${#TIMEOUT_CMD[@]} -gt 0 ]]; then
+    "${TIMEOUT_CMD[@]}" "${CMD[@]}"
+else
+    "${CMD[@]}"
+fi
