+def harbor_run(import_path, job_name, n_trials=2, n_concurrent=8, task_set=None):
+    """Run Harbor on a HANDBOOK.md task set with the candidate harness module.
+
+    The result is None if Harbor fails or times out.
+    Callers do not parse partial results from timed-out jobs.
+    """
+    cmd = [
+        str(EVOLVE_DIR / "scripts" / "run_eval.sh"),
+        str(candidate_file_of(import_path)),
+        task_set or EVAL_TASK_SET,
+        str(n_trials),
+        str(n_concurrent),
+        "--job-name",
+        job_name,
+        "--jobs-dir",
+        str(JOBS_DIR),
+    ]
+
+    env = os.environ.copy()
+    env["HARBOR_MODEL"] = MODEL
+    env["HARBOR_TIMEOUT_SECONDS"] = str(HARBOR_TIMEOUT_SECONDS)
+    env["HARBOR_EXTERNAL_TIMEOUT"] = "1"
+
+    try:
+        result = subprocess.run(
+            cmd,
+            cwd=str(EVOLVE_DIR),
+            timeout=HARBOR_TIMEOUT_SECONDS,
+            stdout=None,
+            stderr=subprocess.PIPE,
+            text=True,
+            env=env,
+        )
+    except subprocess.TimeoutExpired:
+        result = subprocess.CompletedProcess(
+            cmd, 124, "", f"Timed out after {HARBOR_TIMEOUT_SECONDS}s"
+        )
+
+    job_dir = JOBS_DIR / job_name
+    if result.returncode not in (0, 124):
+        print(f"  {_red('harbor failed')} exit={result.returncode} job={job_name}")
+        if result.stderr:
+            print(f"  {result.stderr[:500]}")
+        return job_dir, None
+
+    if result.returncode == 124:
+        print(f"  {_yellow('harbor timed out')} job={job_name}")
+        return job_dir, None
+
+    return job_dir, True  # signal success; callers use parse_job_results directly
+
+
+def trial_dirs(job_dir):
+    return [d for d in sorted(job_dir.iterdir()) if d.is_dir() and "__" in d.name]
+
+
+def task_of(trial_dir):
+    """The trial's full task name. Harbor truncates trial dir names to 32
+    characters, which collides for HANDBOOK.md's long task ids, so read it
+    from result.json / config.json and fall back to the dir prefix."""
+    for f in ("result.json", "config.json"):
+        rf = trial_dir / f
+        if rf.exists():
+            try:
+                m = re.search(r"sop-tasks/([a-z0-9_]+)", rf.read_text())
+            except OSError:
+                m = None
+            if m:
+                return m.group(1)
+    return trial_dir.name.rsplit("__", 1)[0]
+
+
+def parse_job_results(job_dir, expected_trials=None):
+    """Parse per-task rewards from a harbor job directory.
+
+    Always reads individual trial dirs (ground truth). Every trial dir counts:
+    no result.json, no verifier_result, corrupt JSON, errored trials all count
+    as reward=0.
+
+    Returns dict: {task_name: [reward1, reward2, ...]}
+    """
+    task_rewards = {}
+
+    for trial_dir in trial_dirs(job_dir):
+        task = task_of(trial_dir)
+        rf = trial_dir / "result.json"
+        if not rf.exists():
+            task_rewards.setdefault(task, []).append(0.0)
+            continue
+        try:
+            r = json.loads(rf.read_text())
+        except (json.JSONDecodeError, OSError):
+            task_rewards.setdefault(task, []).append(0.0)
+            continue
+
+        vr = r.get("verifier_result") or {}
+        reward = (vr.get("rewards") or {}).get("reward")
+        task_rewards.setdefault(task, []).append(
+            float(reward) if reward is not None else 0.0
+        )
+
+    if expected_trials:
+        for task, rewards in task_rewards.items():
+            if len(rewards) != expected_trials:
+                print(
+                    f"  {_yellow('warning')}: {task} has {len(rewards)}/{expected_trials} trials"
+                )
+
+    return task_rewards
+
+
+def compute_pass_rates(task_rewards):
+    """HANDBOOK.md objective: per-task mean rubric score (0..1, partial credit)
+    and the flat mean over all trials. Returns (per_task, avg). The state files
+    keep the `pass_rate` / `avg_pass_rate` field names of the other examples."""
+    per_task = {}
+    total = 0.0
+    n = 0
+    for task, rewards in task_rewards.items():
+        per_task[task] = sum(rewards) / len(rewards) if rewards else 0.0
+        total += sum(rewards)
+        n += len(rewards)
+    avg = total / n if n else 0.0
+    return per_task, avg
+
+
+def strict_rate(task_rewards):
+    """Fraction of trials that passed every rubric check."""
+    n = sum(len(v) for v in task_rewards.values())
+    return (sum(r >= 0.999 for v in task_rewards.values() for r in v) / n) if n else 0.0
+
+
+def parse_trial_metrics(job_dir):
+    """Extract per-trial rollout metrics from a harbor job directory.
+
+    Returns dict: {task_name: [trial_metrics, ...]}
+    where trial_metrics = {n_input_tokens, n_output_tokens, n_cache_tokens,
+                           cost_usd, n_tool_calls, reward}
+    """
+    per_task = {}
+    for trial_dir in trial_dirs(job_dir):
+        rf = trial_dir / "result.json"
+        if not rf.exists():
+            continue
+        try:
+            r = json.loads(rf.read_text())
+        except (json.JSONDecodeError, OSError):
+            continue
+        ar = r.get("agent_result") or {}
+        md = ar.get("metadata") or {}
+        vr = r.get("verifier_result") or {}
+        metrics = {
+            "n_input_tokens": ar.get("n_input_tokens"),
+            "n_output_tokens": ar.get("n_output_tokens"),
+            "n_cache_tokens": ar.get("n_cache_tokens"),
+            "cost_usd": ar.get("cost_usd"),
+            "n_tool_calls": md.get("n_tool_calls"),
+            "reward": (vr.get("rewards") or {}).get("reward"),
+        }
+        per_task.setdefault(task_of(trial_dir), []).append(metrics)
+    return per_task
+
+
+def summarize_trial_metrics(trial_metrics):
+    """Aggregate per-trial metrics into a summary dict."""
+    all_costs = []
+    all_input = []
+    all_output = []
+    all_cache = []
+    all_calls = []
+    per_task_summary = {}
+
+    for task, trials in trial_metrics.items():
+        task_costs = [t["cost_usd"] for t in trials if t["cost_usd"] is not None]
+        task_calls = [t["n_tool_calls"] for t in trials if t["n_tool_calls"] is not None]
+        per_task_summary[task] = {
+            "mean_cost": round(sum(task_costs) / len(task_costs), 3)
+            if task_costs
+            else None,
+            "mean_tool_calls": round(sum(task_calls) / len(task_calls), 1)
+            if task_calls
+            else None,
+            "n_trials": len(trials),
+        }
+        all_costs.extend(task_costs)
+        all_calls.extend(task_calls)
+        all_input.extend(
+            t["n_input_tokens"] for t in trials if t["n_input_tokens"] is not None
+        )
+        all_output.extend(
+            t["n_output_tokens"] for t in trials if t["n_output_tokens"] is not None
+        )
+        all_cache.extend(
+            t["n_cache_tokens"] for t in trials if t["n_cache_tokens"] is not None
+        )
+
+    n_trials = sum(len(v) for v in trial_metrics.values())
+    return {
+        "n_trials": n_trials,
+        "total_cost_usd": round(sum(all_costs), 2) if all_costs else None,
+        "mean_cost_usd": round(sum(all_costs) / len(all_costs), 3)
+        if all_costs
+        else None,
+        "total_input_tokens": sum(all_input) if all_input else None,
+        "total_output_tokens": sum(all_output) if all_output else None,
+        "total_cache_tokens": sum(all_cache) if all_cache else None,
+        "mean_tool_calls": round(sum(all_calls) / len(all_calls), 1) if all_calls else None,
+        "per_task": per_task_summary,
+    }
+
+
+def count_iterations():
+    """Highest iteration in evolution_summary.jsonl (for resume)."""
+    if not EVOLUTION_SUMMARY.exists():
+        return 0
+    max_iter = 0
+    for line in EVOLUTION_SUMMARY.read_text().strip().split("\n"):
+        if not line.strip():
+            continue
+        try:
+            max_iter = max(max_iter, json.loads(line).get("iteration", 0))
+        except json.JSONDecodeError:
+            continue
+    return max_iter
+
