+def smoke_test(name, import_path):
+    """Run 1 trial on the `smoke` task set to check for runtime crashes."""
+    job_name = f"smoke-{name}"
+    job_dir = JOBS_DIR / job_name
+    if job_dir.exists():
+        run_cmd(["rm", "-rf", str(job_dir)])
+    t0 = time.time()
+    job_dir, ok = harbor_run(import_path, job_name, n_trials=1, n_concurrent=1, task_set="smoke")
+    elapsed = time.time() - t0
+    if not ok:
+        print(f"  {_red('smoke FAIL')}: {name} (harbor failed, {_elapsed(elapsed)})")
+        return False
+    rewards = parse_job_results(job_dir)
+    if not rewards:
+        print(f"  {_red('smoke FAIL')}: {name} (no trials, {_elapsed(elapsed)})")
+        return False
+    trial = trial_dirs(job_dir)[0]
+    if not any((trial / "agent" / "completions").glob("*.json")):
+        print(f"  {_red('smoke FAIL')}: {name} (no completion logs, {_elapsed(elapsed)})")
+        return False
+    audit_ok, msg = leak_audit_trials(job_dir)
+    if not audit_ok:
+        print(f"  {_red('smoke FAIL')}: {name} ({msg})")
+        return False
+    print(f"  {_green('smoke OK')}: {name} (score {list(rewards.values())[0][0]:.2f}, {_elapsed(elapsed)})")
+    return True
