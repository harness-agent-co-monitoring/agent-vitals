+def run_cmd(cmd, timeout=HARBOR_TIMEOUT_SECONDS, cwd=None):
+    """Run a subprocess; return CompletedProcess (returncode=124 on timeout)."""
+    env = os.environ.copy()
+    env["HARBOR_MODEL"] = MODEL
+    # Ensure dotenv-loaded keys survive through the benchmark subprocess
+    for key in ("ANTHROPIC_API_KEY", "OPENROUTER_API_KEY"):
+        val = os.environ.get(key)
+        if val:
+            env[key] = val
+    try:
+        return subprocess.run(
+            cmd, cwd=cwd, timeout=timeout, capture_output=True, text=True, env=env
+        )
+    except subprocess.TimeoutExpired:
+        return subprocess.CompletedProcess(cmd, 124, "", f"Timed out after {timeout}s")
+    except OSError as exc:
+        return subprocess.CompletedProcess(cmd, 127, "", str(exc))
+
+
+# ── Candidate validation ─────────────────────────────────────
+
+
+def module_name_of(import_path):
+    return import_path.split(":", 1)[0].strip()
+
+
+def candidate_file_of(import_path):
+    return EVOLVE_DIR / (module_name_of(import_path).replace(".", "/") + ".py")
+
+
+def load_candidate_class(import_path):
+    """Import agents.<name>:AgentHarness and return (module, class)."""
+    module_name, _, class_name = import_path.partition(":")
+    if not module_name.startswith("agents."):
+        raise ValueError("candidate import path must be agents.<name>:AgentHarness")
+    module = importlib.import_module(module_name)
+    cls = getattr(module, class_name or "AgentHarness", None)
+    from handbook_runner import HandbookRunner
+
+    if cls is None or not inspect.isclass(cls) or not issubclass(cls, HandbookRunner):
+        raise TypeError(f"{import_path} must be a class subclassing handbook_runner.HandbookRunner")
+    return module, cls
+
+
+def validate_candidate_sections(module, rendered):
+    """`prompt_sections(rendered)` must return >= 3 verbatim spans covering >= 80%
+    of the rendered prompt; a present `feedback_sections` must not raise and
+    must return verbatim spans."""
+    fn = getattr(module, "prompt_sections", None)
+    if not callable(fn):
+        return False, "prompt_sections() missing"
+    try:
+        secs = fn(rendered)
+    except Exception as exc:
+        return False, f"prompt_sections() raised: {exc!r}"
+    if not secs or len(secs) < 3:
+        return False, f"prompt_sections() returned {len(secs or [])} spans (>= 3 required)"
+    covered = 0
+    for name, text in secs:
+        text = str(text).strip()
+        if not text or text not in rendered:
+            return False, f"section {name!r} is not verbatim in the rendered prompt"
+        covered += len(text)
+    cov = covered / max(1, len(rendered))
+    if cov < 0.8:
+        return False, f"sections cover {cov:.0%} of the prompt (>= 80% required)"
+    fb = getattr(module, "feedback_sections", None)
+    fb_msg = "no feedback_sections"
+    if callable(fb):
+        try:
+            for name, text in fb(FEEDBACK_PROBE) or []:
+                if str(text) not in FEEDBACK_PROBE:
+                    return False, f"feedback_sections() returned a non-verbatim span {name!r}"
+        except Exception as exc:
+            return False, f"feedback_sections() raised: {exc!r}"
+        fb_msg = "feedback_sections OK"
+    return True, f"{len(secs)} sections, {cov:.0%} coverage, {fb_msg}"
+
+
+@functools.lru_cache(maxsize=None)
+def vitals_importable(module):
+    return run_cmd([VITALS_PYTHON, "-c", f"import {module}"], timeout=120).returncode == 0
+
+
+def leak_corpus():
+    corpus = os.environ.get("HB_LEAK_CORPUS")
+    return Path(corpus).expanduser().resolve() if corpus else None
+
+
+def audit_status():
+    """One line naming which leak audits are active."""
+    if not vitals_importable(LEAK_AUDIT_MODULE):
+        return f"leak audits OFF (agent-vitals not importable by {VITALS_PYTHON})"
+    corpus = leak_corpus()
+    return "trial audit on, code audit " + (f"on ({corpus})" if corpus else "OFF (no HB_LEAK_CORPUS)")
+
+
+def leak_audit_code(candidate_file):
+    """The add-on's leak audit on the candidate module: every string literal,
+    docstring and comment against every task's documents, plus forbidden paths
+    and verifier words. Returns (ok, message)."""
+    corpus = leak_corpus()
+    if corpus is None:
+        return True, "code leak audit skipped (no HB_LEAK_CORPUS)"
+    if not vitals_importable(LEAK_AUDIT_MODULE):
+        return True, "code leak audit skipped (agent-vitals not found)"
+    base = candidate_file_of(BASELINES[0][1])
+    r = run_cmd(
+        [VITALS_PYTHON, "-m", LEAK_AUDIT_MODULE, "code",
+         "--corpus", str(corpus), "--module", str(candidate_file), "--base", str(base)],
+        timeout=600,
+    )
+    try:
+        rep = json.loads(r.stdout)
+    except (json.JSONDecodeError, TypeError):
+        return False, f"code audit did not run (rc={r.returncode}): {(r.stderr or '')[-200:]}"
+    access = rep.get("file_access") or []
+    if rep.get("verdict") == "OK":
+        return True, "leak audit OK" + (f"; file access for review: {len(access)} line(s)" if access else "")
+    why = []
+    if rep.get("ngram_hits"):
+        why.append("handbook/instruction/verifier text: " + "; ".join(h["ngram"] for h in rep["ngram_hits"][:3]))
+    if rep.get("name_hits"):
+        why.append("task-specific names: " + ", ".join(h["name"] for h in rep["name_hits"][:5]))
+    if rep.get("forbidden"):
+        why.append("forbidden paths/words: " + ", ".join(rep["forbidden"]))
+    return False, "LEAK — " + " | ".join(why)
+
+
+def leak_audit_trials(job_dir):
+    """Scan every trial's logged tool calls for out-of-bounds access (/tests,
+    /initial_data, /logs, verifier files). Returns (ok, message); a hit voids
+    the benchmark."""
+    trials = [d for d in sorted(job_dir.iterdir()) if d.is_dir() and "__" in d.name]
+    if not trials:
+        return True, "no trials"
+    if not vitals_importable(LEAK_AUDIT_MODULE):
+        return True, "trial audit skipped (agent-vitals not found)"
+    r = run_cmd([VITALS_PYTHON, "-m", LEAK_AUDIT_MODULE, "trial", "--trial", *map(str, trials)], timeout=600)
+    if r.returncode not in (0, 2):
+        return False, f"trial audit did not run (rc={r.returncode}): {(r.stderr or '')[-200:]}"
+    bad = []
+    for line in (r.stdout or "").splitlines():
+        try:
+            rep = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if rep.get("verdict") != "OK":
+            bad.append(f"{rep['trial'][:40]}: {rep['hits'][0]['tool']} {rep['hits'][0]['matched']}")
+    return (not bad), ("trial audit OK" if not bad else "LEAK — " + "; ".join(bad[:3]))
+
+
+def validate_agent(import_path):
+    """--validate-agent: class, rendered prompt, budget, section declarations,
+    code leak audit. Prints OK on success; returns the exit code."""
+    try:
+        module, cls = load_candidate_class(import_path)
+        runner = cls(dict(SAMPLE_CONFIG))
+        rendered = runner.system_prompt()
+        n_iter = runner.max_iterations()
+    except Exception as exc:
+        print(f"Invalid candidate {import_path}: {exc}", file=sys.stderr)
+        return 1
+    n_words = len(rendered.split())
+    checks = [
+        (n_iter <= MAX_TOOL_CALLS, f"max_iterations() = {n_iter} exceeds the benchmark's {MAX_TOOL_CALLS}"),
+        (n_words <= MAX_PROMPT_WORDS, f"system prompt is {n_words} words (keep it under {MAX_PROMPT_WORDS})"),
+    ]
+    for ok, msg in checks:
+        if not ok:
+            print(f"Invalid candidate {import_path}: {msg}", file=sys.stderr)
+            return 1
+    sections_ok, sections_msg = validate_candidate_sections(module, rendered)
+    if not sections_ok:
+        print(f"Invalid candidate {import_path}: {sections_msg}", file=sys.stderr)
+        return 1
+    audit_ok, audit_msg = leak_audit_code(candidate_file_of(import_path))
+    if not audit_ok:
+        print(f"Invalid candidate {import_path}: {audit_msg}", file=sys.stderr)
+        return 1
+    print(f"OK: {import_path} | prompt {n_words} words | max_iterations {n_iter} | {sections_msg} | {audit_msg}")
+    return 0
+
