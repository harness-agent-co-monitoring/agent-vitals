+                    tm = metrics_summary.get("per_task", {}).get(task, {})
+                    tc = (
+                        f"${tm['mean_cost']:.2f}"
+                        if tm.get("mean_cost") is not None
+                        else ""
+                    )
+                    tt = (
+                        f"{tm['mean_tool_calls']:.0f} calls"
+                        if tm.get("mean_tool_calls") is not None
+                        else ""
+                    )
+                    suffix = f"  {_dim(tc)} {_dim(tt)}" if tc else ""
+                    print(
+                        f"         {task:<{max_name_len}}  {_rate_str(rate)}  {td_c}{suffix}"
+                    )
+            else:
+                results[name] = ({}, 0)
+                if void_reason:
+                    print(f"         {_red('VOID')} {void_reason} ({_elapsed(elapsed)})")
+                else:
+                    print(
+                        f"         {_red('FAIL')} benchmark crashed ({_elapsed(elapsed)})"
+                    )
+
+        bench_time = time.time() - bench_start
+
+        if args.vitals and benchmarked and not _interrupted:
+            run_vitals_replay([j for j, _ in benchmarked], [n for _, n in benchmarked], args.vitals_subsample)
+            run_vitals_digest([n for _, n in benchmarked], iteration,
+                              parents={c["name"]: c.get("base_system", "") for c in valid})
+
+        update_frontier(results)
+        update_evolution_summary(
+            iteration,
+            valid,
+            results,
+            propose_time=propose_time,
+            bench_time=bench_time,
+            metrics=all_metrics,
+        )
+
+        wall_time = time.time() - iter_start
+        frontier_now = (
+            json.loads(FRONTIER_VAL.read_text()) if FRONTIER_VAL.exists() else {}
+        )
+        new_best_avg = frontier_now.get("_best", {}).get("avg_pass_rate", 0)
+        new_best_agent = frontier_now.get("_best", {}).get("agent", "none")
+        improved = new_best_avg > best_avg
+        status = _green("NEW BEST") if improved else _dim("no improvement")
+        print(f"  {_ts()} {status}  frontier={new_best_agent} @ {new_best_avg:.1%}")
+        print(
+            f"  {_dim(f'timing: propose={_elapsed(propose_time)} bench={_elapsed(bench_time)} total={_elapsed(wall_time)}')}"
+        )
+
+    # ── Phase Final: holdout (sibling rule-variants), frontier + baseline ──
+    if _interrupted or not args.full_eval:
+        return
+
+    print(f"\n{_ts()} {_bold(f'Phase Final: holdout x {HOLDOUT_TRIALS} trials for the frontier agent and the baseline')}")
+    frontier = json.loads(FRONTIER_VAL.read_text()) if FRONTIER_VAL.exists() else {}
+    best_agent = frontier.get("_best", {}).get("agent")
+    todo = [(BASELINE_AGENT_NAME, BASELINES[0][1])]
+    if best_agent and best_agent != BASELINE_AGENT_NAME and EVOLUTION_SUMMARY.exists():
+        for line in EVOLUTION_SUMMARY.read_text().strip().split("\n"):
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if row.get("agent") == best_agent and row.get("import_path"):
+                todo.append((best_agent, row["import_path"]))
+                break
+    for agent, import_path in todo:
+        job_name = f"final-{agent}-holdout-t{HOLDOUT_TRIALS}"
+        job_dir = JOBS_DIR / job_name
+        if job_dir.exists() and parse_job_results(job_dir):
+            print(f"  {_dim('cached')} {job_name}")
+        else:
+            print(f"  {_ts()} running {_bold(agent)} on the holdout x {HOLDOUT_TRIALS} trials...", flush=True)
+            t0 = time.time()
+            harbor_run(import_path, job_name, n_trials=HOLDOUT_TRIALS, n_concurrent=args.concurrent, task_set=HOLDOUT_TASK_SET)
+            print(f"  ({_elapsed(time.time() - t0)})")
+        if not job_dir.exists():
+            continue
+        audit_ok, audit_msg = leak_audit_trials(job_dir)
+        task_rewards = parse_job_results(job_dir, expected_trials=HOLDOUT_TRIALS)
+        per_task, avg = compute_pass_rates(task_rewards)
+        print(f"  {_bold(agent)} holdout: score={_rate_str(avg)}  strict={strict_rate(task_rewards):.0%}  {audit_msg}")
+        max_name_len = max(len(t) for t in per_task) if per_task else 0
+        for task, rate in sorted(per_task.items()):
+            print(f"    {task:<{max_name_len}}  {_rate_str(rate)}")
+        with open(LOGS_DIR / "holdout.jsonl", "a") as f:
+            f.write(json.dumps({"agent": agent, "job": job_name, "avg_score": round(avg, 4),
+                                "strict": round(strict_rate(task_rewards), 4),
+                                "per_task": {k: round(v, 4) for k, v in per_task.items()},
+                                "audit": audit_msg, "audit_ok": audit_ok}) + "\n")
+
+    print(f"\n{_ts()} {_bold('Evolution complete.')}")
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Harness evolution loop for HANDBOOK.md"
+    )
+    parser.add_argument(
+        "--iterations", type=int, default=5, help="Number of evolution iterations"
+    )
+    parser.add_argument(
+        "--trials",
+        type=int,
+        default=DEFAULT_SEARCH_TRIALS,
+        help="Trials per task during evolution (default: 2)",
+    )
+    parser.add_argument(
+        "--propose-timeout",
+        type=int,
+        default=7200,
+        help="Timeout for proposer (seconds)",
+    )
+    parser.add_argument(
+        "--run-name",
+        type=str,
+        default=None,
+        help="Run name for isolated output dirs (jobs/<run>/*, logs/<run>/*). Auto-generated if not set.",
+    )
+    parser.add_argument(
+        "--fresh", action="store_true", help="Clear proposed agents and reset logs"
+    )
+    parser.add_argument(
+        "--skip-baseline", action="store_true", help="Skip Phase 0 baseline eval"
+    )
+    parser.add_argument("--skip-smoke", action="store_true", help="Skip smoke tests")
+    parser.add_argument(
+        "--full-eval",
+        action="store_true",
+        help=f"Phase Final: run the frontier agent and the baseline on the holdout variants x {HOLDOUT_TRIALS} trials",
+    )
+    parser.add_argument(
+        "--concurrent",
+        type=int,
+        default=DEFAULT_CONCURRENCY,
+        help=f"Max concurrent trials (default: {DEFAULT_CONCURRENCY})",
+    )
+    parser.add_argument(
+        "--leak-corpus",
+        type=str,
+        default=None,
+        help="Leak-audit corpus (JSONL of every task's documents; default: $HB_LEAK_CORPUS). "
+        "Without one the code leak audit is skipped.",
+    )
+    parser.add_argument(
+        "--vitals",
+        action="store_true",
+        help="Replay a trial subsample of every benchmark through agent-vitals (GPU) "
+        "and give the proposer a per-section read digest",
+    )
+    parser.add_argument(
+        "--vitals-subsample",
+        type=int,
+        default=6,
+        help="With --vitals: trials per agent to replay (outcome-stratified; default: 6)",
+    )
+    parser.add_argument(
+        "--validate-agent",
+        metavar="MODULE:CLASS",
+        help=argparse.SUPPRESS,
+    )
+    args = parser.parse_args()
+
+    if args.leak_corpus:
+        os.environ["HB_LEAK_CORPUS"] = args.leak_corpus
+
+    if args.validate_agent:
+        return validate_agent(args.validate_agent)
+
+    signal.signal(signal.SIGINT, _handle_signal)
+    signal.signal(signal.SIGTERM, _handle_signal)
+    run_evolve(args)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
