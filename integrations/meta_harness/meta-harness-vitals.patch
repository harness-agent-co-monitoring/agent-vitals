+def run_vitals_replay(job_dirs, agents, subsample, timeout=3 * 60 * 60):
+    """Replay an outcome-stratified subsample of each job's trials through the
+    reference model (needs the GPU). Non-fatal."""
+    jobs = [str(j) for j in job_dirs if j and Path(j).is_dir()]
+    if not jobs:
+        return
+    print(f"  {_ts()} {_cyan('vitals replay')} {len(jobs)} job(s) (subsample {subsample})...", flush=True)
+    t0 = time.time()
+    result = run_cmd(
+        [VITALS_PYTHON, "-m", "vitals.cli", "metaharness", "replay-inloop-handbook",
+         "--jobs", *jobs, "--agent", *agents, "--out", str(VITALS_DIR),
+         "--subsample", str(subsample), "--agents-dir", str(AGENTS_DIR)],
+        timeout=timeout,
+    )
+    for line in (result.stdout or "").strip().split("\n")[-3:]:
+        print(f"    {_dim(line)}")
+    if result.returncode != 0:
+        print(f"    {_red('vitals replay FAIL')} (rc={result.returncode}): {(result.stderr or '')[-300:]}")
+    else:
+        print(f"    {_green('OK')} ({_elapsed(time.time() - t0)})")
+
+
+def run_vitals_digest(agents, iteration, parents=None, timeout=20 * 60):
+    """Per-section digest for the next propose: vitals_digest.md/.parquet in
+    each agent's job dir and logs/<run>/reports/vitals_iteration_NN.md.
+    CPU only. Non-fatal. `parents` = {agent: base_system}."""
+    if not agents:
+        return
+    print(f"  {_ts()} {_cyan('vitals digest')} {len(agents)} agent(s)...", flush=True)
+    hints = [f"--parent-hint={n}={b}" for n, b in (parents or {}).items() if b]
+    result = run_cmd(
+        [VITALS_PYTHON, "-m", "vitals.cli", "metaharness", "digest-handbook",
+         "--vitals-dir", str(VITALS_DIR), "--jobs-dir", str(JOBS_DIR),
+         "--reports-dir", str(LOGS_DIR / "reports"), "--systems", *agents,
+         "--iteration", str(iteration), "--per-trial", *hints],
+        timeout=timeout,
+    )
+    for line in (result.stdout or "").strip().split("\n")[-2:]:
+        print(f"    {_dim(line)}")
+    if result.returncode != 0:
+        print(f"    {_red('vitals digest FAIL')} (rc={result.returncode}): {(result.stderr or '')[-300:]}")
+
