+        sys.exit("HB_ROOT must point to a HANDBOOK.md checkout (git clone https://github.com/surge-ai/handbook)")
+    corpus = leak_corpus()
+    if corpus is not None:
+        if not corpus.is_file():
+            sys.exit(f"leak corpus not found: {corpus}")
+        if corpus.is_relative_to(EVOLVE_DIR.resolve()):
+            sys.exit("keep the leak corpus outside this directory: it holds every task's documents")
+    if args.vitals and not vitals_importable("vitals.addons.metaharness"):
+        sys.exit(f"--vitals needs agent-vitals importable by VITALS_PYTHON ({VITALS_PYTHON})")
