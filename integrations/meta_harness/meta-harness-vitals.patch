+"""HANDBOOK.md baseline harness: the benchmark's own OpenHands loop and
+office-assistant prompt, as a HandbookRunner subclass with no overrides beyond
+the prompt text (rendered verbatim). Copy this file to start a candidate and
+override any HandbookRunner method (see handbook_runner.py: system_prompt,
+llm_kwargs, build_llm, build_condenser, extra_tools, on_event,
+build_conversation, run_loop, max_iterations).
+
+Import ``openhands.sdk`` only inside methods: this module is also imported on
+the host (no SDK there) to validate the class and the declarations below.
+"""
+from handbook_runner import HandbookRunner
+
+SYSTEM_PROMPT = (
+    "{date} You are an office assistant with access to the user's filesystem (/workdir), "
+    "email (google_mail_*), slack (slack_*), calendar (google_calendar_*), jira (jira_*), and "
+    "shopify (shopify_*) tools. The workspace directory /workdir contains files for the task. "
+    "Do NOT ask the user for more information — use your tools to discover what you need. "
+    "Begin by listing /workdir and reading relevant files."
+)
+
+
+class AgentHarness(HandbookRunner):
+    def system_prompt(self) -> str:
+        return SYSTEM_PROMPT.replace("{date}", self.date_sentence()).strip()
+
+
+def prompt_sections(system_prompt: str) -> list[tuple[str, str]] | None:
+    """Label the harness sentence by sentence on the RENDERED system prompt.
+
+    Contract (checked at candidate validation, and per trial when the
+    white-box replay attributes the worker's reading to these spans): return
+    (section_name, exact_text) pairs in order; every text verbatim in
+    ``system_prompt``; together >= 80% of it; >= 3 sections, one per distinct
+    instruction. SELF-CONTAINED (stdlib only, constants in the body); update
+    it whenever you add, remove, or reword prompt text.
+    """
+    import re
+    names = ["date", "role", "workspace", "no-ask", "begin"]
+    sents = [x.strip() for x in re.split(r"(?<=\.)\s+(?=[A-Z])", system_prompt.strip()) if x.strip()]
+    if len(sents) < 3:
+        return None
+    if len(sents) != len(names):
+        names = [f"s{i}" for i in range(len(sents))]
+    return list(zip(names, sents))
+
+
+def feedback_sections(observation_text: str) -> list[tuple[str, str]] | None:
+    """OPTIONAL companion: label HARNESS-AUTHORED spans inside one tool result
+    or user message the worker received mid-episode (reminders, verification
+    prompts, injected headers). The baseline injects nothing."""
+    return None
