+def render_task_prompt(iteration, n_trials, vitals=False, kit_dir=None):
+    """Build the prompt for the proposer Claude session."""
+    prompt = (
+        f"Run iteration {iteration} of the harness evolution loop (HANDBOOK.md). "
+        f"Worker model: {MODEL}. "
+        f"Start from agents/baseline_openhands.py as the parent.\n\n"
+        f"## Eval split: {N_EVAL_TASKS} HANDBOOK.md tasks (one rule-variant per base handbook) x {n_trials} trials\n\n"
+        f"The objective is the mean rubric score (0..1, partial credit over each task's "
+        f"expected-output and prohibited-behaviour checks), averaged over all trials; the "
+        f"strict pass rate (every check passed) is reported beside it. Single-run scores are "
+        f"noisy, which is why every candidate gets {n_trials} trials per task.\n\n"
+        f"## The candidate surface\n"
+        f"A candidate is an agent harness: `agents/<name>.py` defining "
+        f"`class AgentHarness(HandbookRunner)` (the base is `handbook_runner.py`) plus "
+        f"`prompt_sections()` and, if it injects text at run time, `feedback_sections()`. "
+        f"The environment, its MCP tools and the worker model are the benchmark's; the "
+        f"{MAX_TOOL_CALLS}-call budget may be lowered, never raised. The handbook is a file in "
+        f"the worker's /workdir that the worker must find and read with its own tool calls: a "
+        f"harness may change how the worker finds, converts, reads, quotes or re-checks it, but "
+        f"never opens the environment itself, never pre-loads or pre-digests the handbook, and "
+        f"never carries any handbook, instruction or verifier text, any company/person/product "
+        f"name, any rule, threshold or deadline, or any path outside /workdir. Validation audits "
+        f"every string and comment of the module against every task's documents (an 8-word "
+        f"verbatim match, or a name that belongs to one handbook family) and REJECTS on a hit; "
+        f"a benchmark is VOIDED if any tool call of any trial reaches /tests, /initial_data, "
+        f"/logs or a verifier file.\n\n"
+        f"## Section annotation (required)\n"
+        f"`prompt_sections(system_prompt)` must return (name, exact_text) spans over the "
+        f"RENDERED system prompt (date sentence included): >= 3 sections, verbatim, >= 80% "
+        f"coverage. Copy the implementation from agents/baseline_openhands.py and keep it in "
+        f"step with your text; validation rejects a missing, stale or coarse declaration. "
+        f"Validate with `{sys.executable} meta_harness.py --validate-agent agents.<name>:AgentHarness` "
+        f"from `{EVOLVE_DIR}`.\n\n"
+        f"## Run directories\n"
+        f"All logs and results for this run are under `{LOGS_DIR}/`.\n"
+        f"- `{EVOLUTION_SUMMARY}` — past results\n"
+        f"- `{FRONTIER_VAL}` — frontier\n"
+        f"- `{LOGS_DIR / 'reports'}/` — post-eval reports\n"
+        f"- transcripts: `{JOBS_DIR}/<job>/<task>__<id>/agent/completions/*.json` (one file per "
+        f"LLM call: the exact request and the response with `reasoning_content` and tool calls) "
+        f"and `agent/run-openhands.log`; scores in `verifier/reward.txt`\n"
+        f"- Write pending_eval.json to: `{PENDING_EVAL}` (include an `evidence` field: which "
+        f"sources drove the hypothesis — scores, transcripts with trial + turn, or the "
+        f"measurement reports if provided)"
+    )
+    if vitals:
+        prompt += (
+            f"\n\n## Worker read-maps (per-section digest)\n"
+            f"Every benchmarked agent has a `vitals_digest.md` (and a `.parquet`) "
+            f"in its job directory under `{JOBS_DIR}/`, and consolidated "
+            f"per-iteration reports are in `{LOGS_DIR / 'reports'}/"
+            f"vitals_iteration_*.md` (latest: "
+            f"`vitals_iteration_{max(0, iteration - 1):02d}.md`). Rows are the "
+            f"fine-grained sections of the worker's context, measured on how the "
+            f"frozen worker actually read them over a replayed subsample of trials: "
+            f"your harness sentence by sentence (the spans `prompt_sections()` "
+            f"declares), the task instruction, the tool schemas, tool results, the "
+            f"worker's own earlier messages, and — from the turn the worker read the "
+            f"file in — the handbook's passages:\n"
+            f"- `footprint_tok` — tokens the section costs; `share` — attention it drew\n"
+            f"- `lift` (READ LIFT) — per-token read intensity vs a fair share for its "
+            f"length (1 = fair, >1 studied, <1 under-read)\n"
+            f"- `peak` (PEAK LIFT) — the same for the section's 8 hottest content tokens: "
+            f"a cold average with a hot peak is a lookup, not a skip\n"
+            f"- `consult` (CONSULT RATIO) and `contrast` — how much more the section is "
+            f"read when the worker is uncertain (1 = no preference)\n"
+            f"- `lift_z_role` / `consult_z_role` — each vs the norm for that role across "
+            f"all agents so far\n"
+            f"Each digest opens with headlines (the harness sentence read hardest and "
+            f"the one read least, the hottest handbook passage at a turn that acts), "
+            f"then a per-trial map: task, score, the parent's score on the same task, "
+            f"turns, prompt size, the pooled lift of the harness, the instruction and "
+            f"the handbook at the turns that act (mail/slack/jira/calendar/file writes, "
+            f"python/bash), the hottest handbook passage there with its hot line, a "
+            f"`read_once` flag (read the handbook on entry, never went back), and the "
+            f"worker's entropy early vs late. These are correlational measurements of "
+            f"the frozen worker, not judgments, and nothing here is scored: the rubric "
+            f"score remains the only objective. They are evidence for a mechanism, never "
+            f"a target: a hypothesis must predict a score change, a read-map observation "
+            f"counts only when a transcript corroborates it (cite trial and turn), and no "
+            f"candidate should exist to move a number in these tables. Record what drove "
+            f"the hypothesis in the `evidence` field of pending_eval.json.\n"
+            f"Each digest also carries a `Delta vs parent` block: the agent's first "
+            f"prompt diffed token by token against the agent its `base_system` names "
+            f"(default: the frontier agent), on the same tasks, with the read lift of "
+            f"the text the edit added, removed and kept, pooled over the replayed turns, "
+            f"and the two agents' scores per task. Name the agent you edited in "
+            f"`base_system` (optional field of pending_eval.json) so the delta is "
+            f"computed against it.\n"
+            f"\nThe raw per-token data behind the digest is in "
+            f"`{VITALS_DIR}/<agent>--handbook/store` (per prompt token: decoded text, "
+            f"owning section, attention received; per generated token: entropy, top-K "
+            f"logprobs)."
+        )
+        if kit_dir:
+            prompt += (
+                f" Schema: `{kit_dir / 'VITALS_SCHEMA.md'}`; loader: "
+                f"`{kit_dir / 'vitals_data.py'}`; run your own analysis with "
+                f"`{VITALS_PYTHON}` (has pandas/pyarrow) if the digest is not enough."
+            )
+    return prompt
