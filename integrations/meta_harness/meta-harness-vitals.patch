+def vitals_kit_dir():
+    """The add-on's proposer kit (raw-data schema + standalone loader)."""
+    r = run_cmd(
+        [VITALS_PYTHON, "-c",
+         "import vitals.addons.metaharness.proposer_kit as k; print(k.__path__[0])"],
+        timeout=120,
+    )
+    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
