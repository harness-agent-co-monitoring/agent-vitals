+SAMPLE_CONFIG = {
+    "instruction": "Please handle the unread items in my inbox according to the handbook.",
+    "systemPrompt": "Today's date is, April, 7, 2026, noon. You are an office assistant.",
+    "model": MODEL,
+    "mcpUrl": "http://localhost:8000/mcp",
+    "maxToolCalls": MAX_TOOL_CALLS,
+    "llmKwargs": {},
+    "logDir": "/tmp/openhands_validate",
+}
+FEEDBACK_PROBE = "[Tool 'syntara__listFiles' executed.]{\"files\": []}"
+
+_interrupted = False
+
+
+def _handle_signal(signum, frame):
+    global _interrupted
+    _interrupted = True
+    print("\nInterrupted, finishing current step...", flush=True)
