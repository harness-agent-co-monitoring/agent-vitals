+def fresh_start():
+    """Clear proposed agents (keep the baseline) and logs for a fresh run."""
+    if AGENTS_DIR.exists():
+        for f in AGENTS_DIR.iterdir():
+            if f.name in ("__pycache__", "__init__.py", "baseline_openhands.py"):
+                continue
+            if f.is_dir():
+                run_cmd(["rm", "-rf", str(f)])
+                print(f"  Cleared {f.name}/")
+            elif f.suffix == ".py":
+                f.unlink()
+                print(f"  Cleared {f.name}")
+
+    for f in [EVOLUTION_SUMMARY, FRONTIER_VAL, PENDING_EVAL]:
+        if f.exists():
+            f.unlink()
+
+    print("  Fresh start: cleared generated agents/ files and log files")
+
