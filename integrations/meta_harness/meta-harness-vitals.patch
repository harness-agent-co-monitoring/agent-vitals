+def validate_prompt_sections(
+    sections: list[tuple[str, str]] | None, prompt: str, min_coverage: float = 0.8
+) -> tuple[bool, str]:
+    """Check a prompt_sections() declaration against the prompt it describes.
+
+    Every declared text must occur verbatim in the prompt, and together the
+    texts must cover at least min_coverage of its characters. Returns (ok, reason).
+    """
+    if not sections:
+        return False, "no sections declared"
+    covered = [False] * len(prompt)
+    for name, text in sections:
+        if not name or not text:
+            return False, "empty name or text"
+        start = prompt.find(text)
+        if start < 0:
+            return False, f"section {name!r} not found verbatim"
+        covered[start : start + len(text)] = [True] * len(text)
+    coverage = sum(covered) / max(len(prompt), 1)
+    if coverage < min_coverage:
+        return False, f"coverage {coverage:.0%} < {min_coverage:.0%}"
+    return True, f"ok ({len(sections)} sections, {coverage:.0%} coverage)"
