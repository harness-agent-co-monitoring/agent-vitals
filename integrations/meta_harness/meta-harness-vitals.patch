@@ -0,0 +1,288 @@
+"""In-container agent harness base for HANDBOOK.md: the overridable form of the
+benchmark's ``openhands_runner.py``, with identical baseline behaviour.
+
+A harness candidate is a module defining ``class AgentHarness(HandbookRunner)``
+that overrides any of the methods below (system prompt, LLM and its kwargs,
+condenser, extra in-episode tools, event handling, conversation, run loop,
+tool-call budget) plus the ``prompt_sections`` / ``feedback_sections``
+declarations. ``candidate_agent.py`` uploads this file and the candidate next
+to each other into the task container and execs
+
+    <runner venv python> handbook_runner.py <config.json> <output.json> --candidate candidate.py
+
+Import ``openhands.sdk`` lazily, inside methods, as this file does: the same
+module is imported on the host (no SDK there) to validate a candidate before a
+benchmark is spent on it.
+
+Not a candidate's to change (the benchmark's rules): the environment and its
+tools stay as served; every piece of environment content reaches the model
+through a tool call the model issued (a harness never opens /workdir, /data,
+/initial_data, /tests or /logs itself, and never pre-loads or pre-digests the
+handbook); the tool-call budget can be lowered, never raised.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from typing import Any
+
+MCP_TOOL_TIMEOUT = 300
+WORKSPACE_DIR = "/tmp/openhands_workspace"
+STATE_DIR = "/tmp/openhands_state"
+TOOL_OBSERVATION_CHAR_LIMIT = 1_000_000
+BENCHMARK_MAX_TOOL_CALLS = 200
+
+
+def _log(msg: str) -> None:
+    print(msg, file=sys.stderr, flush=True)
+
+
+def resolve_llm_kwargs(config: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
+    llm_kwargs = dict(config.get("llmKwargs") or {})
+    effort = llm_kwargs.pop("reasoning_effort", None)
+    if effort is not None:
+        effort = str(effort).strip().lower() or None
+    return llm_kwargs, effort
+
+
+def resolve_llm_auth(model_name: str) -> tuple[str, str | None, str | None]:
+    if "/" not in model_name:
+        raise ValueError(f"model must be in 'provider/model' form; got {model_name!r}")
+    provider, model = model_name.split("/", 1)
+    if provider == "openrouter" and model.startswith("anthropic/"):
+        provider = "anthropic"
+        model = model.split("/", 1)[1].replace(".", "-")
+    if provider == "anthropic":
+        return f"anthropic/{model}", os.environ.get("ANTHROPIC_API_KEY"), os.environ.get("ANTHROPIC_BASE_URL")
+    key_env = {"openai": "OPENAI_API_KEY", "openrouter": "OPENROUTER_API_KEY",
+               "google": "GEMINI_API_KEY", "gemini": "GEMINI_API_KEY"}
+    api_key = os.environ.get(key_env.get(provider, ""))
+    base_url = os.environ.get("OPENAI_BASE_URL") if provider == "openai" else None
+    return model_name, api_key, base_url
+
+
+def usage_of(*llms: Any) -> dict[str, int | float | None]:
+    input_tokens = output_tokens = cache_tokens = None
+    cost: float | None = None
+
+    def acc(current, value):
+        if not isinstance(value, (int, float)):
+            return current
+        return value if current is None else current + value
+
+    for llm in llms:
+        metrics = getattr(llm, "metrics", None)
+        if metrics is None:
+            continue
+        cost = acc(cost, getattr(metrics, "accumulated_cost", None))
+        tu = getattr(metrics, "accumulated_token_usage", None)
+        if tu is None:
+            continue
+        input_tokens = acc(input_tokens, getattr(tu, "prompt_tokens", None))
+        output_tokens = acc(output_tokens, getattr(tu, "completion_tokens", None))
+        cache_tokens = acc(cache_tokens, getattr(tu, "cache_read_tokens", None))
+    return {"input_tokens": input_tokens, "output_tokens": output_tokens,
+            "cache_tokens": cache_tokens, "cost_usd": cost if cost else None}
+
+
+def raise_tool_observation_limit() -> None:
+    import openhands.sdk.llm.message as _message
+    import openhands.sdk.utils.truncate as _truncate
+    _truncate.DEFAULT_TEXT_CONTENT_LIMIT = TOOL_OBSERVATION_CHAR_LIMIT
+    _message.DEFAULT_TEXT_CONTENT_LIMIT = TOOL_OBSERVATION_CHAR_LIMIT
+
+
+class HandbookRunner:
+    """The baseline harness, one method per decision a candidate may override."""
+
+    def __init__(self, config: dict[str, Any]):
+        self.config = config
+        self.n_tool_calls = 0
+        self.n_agent_errors = 0
+        self.final_output = ""
+        self.error_message: str | None = None
+        self.llm = None
+        self.condenser_llm = None
+        self.litellm_model, self.api_key, self.base_url = resolve_llm_auth(config["model"])
+        self._llm_kwargs, self.reasoning_effort = resolve_llm_kwargs(config)
+        providers = self._llm_kwargs.pop("openrouter_provider", None) or ""
+        self.openrouter_providers = [p for p in str(providers).split(",") if p]
+        if self._llm_kwargs.pop("log_completions", False):
+            log_root = config.get("logDir") or WORKSPACE_DIR
+            self._llm_kwargs["log_completions"] = True
+            self._llm_kwargs["log_completions_folder"] = os.path.join(log_root, "completions")
+            _log(f"completion logging enabled -> {self._llm_kwargs['log_completions_folder']}")
+
+    # ---- the harness surface -------------------------------------------------
+
+    def system_prompt(self) -> str:
+        """The system message. `config['systemPrompt']` is the task's own
+        prompt (its date sentence first); a candidate typically rewrites the
+        text after the date sentence and keeps the date."""
+        return self.config["systemPrompt"]
+
+    def date_sentence(self) -> str:
+        first = self.config["systemPrompt"].strip()
+        return first.split(". ", 1)[0].rstrip(".") + "." if ". " in first else first
+
+    def instruction(self) -> str:
+        return self.config["instruction"]
+
+    def llm_kwargs(self) -> dict[str, Any]:
+        """Constructor kwargs for both LLMs (temperature, top_p, ...)."""
+        return dict(self._llm_kwargs)
+
+    def build_llm(self, usage_id: str):
+        from pydantic import SecretStr
+        from openhands.sdk import LLM
+        llm = LLM(usage_id=usage_id, model=self.litellm_model,
+                  api_key=SecretStr(self.api_key) if self.api_key else None,
+                  base_url=self.base_url, timeout=600, **self.llm_kwargs())
+        if self.reasoning_effort is not None:
+            if self.litellm_model.startswith("anthropic/"):
+                llm.reasoning_effort = self.reasoning_effort
+            else:
+                llm.litellm_extra_body = {**llm.litellm_extra_body, "reasoning": {"effort": self.reasoning_effort}}
+        if self.litellm_model.startswith("openrouter/") and self.openrouter_providers:
+            llm.litellm_extra_body = {**llm.litellm_extra_body,
+                                      "provider": {"order": self.openrouter_providers, "allow_fallbacks": False}}
+        return llm
+
+    def build_condenser(self):
+        """Context policy. Baseline: the SDK's LLMSummarizingCondenser at its
+        defaults (fires only on overflow). Return None for no condensation."""
+        from openhands.sdk import LLMSummarizingCondenser
+        self.condenser_llm = self.build_llm("condenser")
+        return LLMSummarizingCondenser(llm=self.condenser_llm)
+
+    def mcp_config(self) -> dict[str, Any]:
+        return {"mcpServers": {"syntara": {"url": self.config["mcpUrl"], "timeout": MCP_TOOL_TIMEOUT}}}
+
+    def extra_tools(self) -> list:
+        """Additional openhands.sdk Tool objects the model may call in-episode
+        (notes, a document search over a file the model opened, ...). They run
+        only when the model calls them."""
+        return []
+
+    def max_iterations(self) -> int:
+        """Tool-call budget: the benchmark's cap or lower, never higher."""
+        return min(BENCHMARK_MAX_TOOL_CALLS, int(self.config["maxToolCalls"]))
+
+    def build_agent(self):
+        from openhands.sdk import Agent
+        self.llm = self.build_llm("agent")
+        return Agent(llm=self.llm, tools=list(self.extra_tools()), mcp_config=self.mcp_config(),
+                     system_prompt=self.system_prompt(), condenser=self.build_condenser())
+
+    def on_event(self, event) -> None:
+        """Every conversation event; the baseline counts tool calls and errors
+        and keeps the agent's last message as the final output."""
+        from openhands.sdk import MessageEvent
+        from openhands.sdk.event import ActionEvent, AgentErrorEvent
+        from openhands.sdk.llm.message import content_to_str
+        if isinstance(event, ActionEvent):
+            self.n_tool_calls += 1
+        elif isinstance(event, AgentErrorEvent):
+            self.n_agent_errors += 1
+            self.error_message = getattr(event, "error", None) or str(event)
+        elif isinstance(event, MessageEvent) and event.source == "agent":
+            text = "".join(content_to_str(event.to_llm_message().content))
+            if text:
+                self.final_output = text
+
+    def build_conversation(self, agent):
+        from openhands.sdk import Conversation
+        return Conversation(agent=agent, callbacks=[self.on_event], workspace=WORKSPACE_DIR,
+                            persistence_dir=STATE_DIR, max_iteration_per_run=self.max_iterations())
+
+    def run_loop(self, conversation) -> None:
+        """The episode. Baseline: send the instruction, run to completion.
+        Override for structured loops (follow-up messages between runs,
+        verification passes, re-read steps); `conversation.send_message()` +
+        `conversation.run()` may be called repeatedly."""
+        conversation.send_message(self.instruction())
+        conversation.run()
+
+    # ---- orchestration (fixed) -----------------------------------------------
+
+    def run(self) -> dict[str, Any]:
+        from openhands.sdk import ConversationExecutionStatus
+        raise_tool_observation_limit()
+        _log(f"Running OpenHands loop (model={self.litellm_model}, base_url={self.base_url or 'default'}, "
+             f"harness={type(self).__module__}.{type(self).__name__})")
+        agent = self.build_agent()
+        conversation = self.build_conversation(agent)
+        saw_error = False
+        try:
+            self.run_loop(conversation)
+        except Exception as e:
+            saw_error = True
+            self.error_message = self.error_message or str(e)
+            _log(f"OpenHands run loop raised: {e}")
+        status = getattr(conversation.state, "execution_status", None)
+        status_val = getattr(status, "value", status)
+        infra_failure = saw_error or status_val == ConversationExecutionStatus.ERROR.value
+        did_work = self.n_tool_calls > 0 or bool(self.final_output)
+        if saw_error or (infra_failure and not did_work):
+            stopped_reason = "error"
+        elif status_val == ConversationExecutionStatus.STUCK.value:
+            stopped_reason = "stuck"
+        elif status_val == ConversationExecutionStatus.FINISHED.value:
+            stopped_reason = "end_turn"
+        else:
+            stopped_reason = "max_tool_calls"
+        usage = usage_of(*[x for x in (self.llm, self.condenser_llm) if x is not None])
+        return {"agent_id": "openhands_sdk", "harness": f"{type(self).__module__}.{type(self).__name__}",
+                "model": self.litellm_model, "final_output": self.final_output,
+                "n_tool_calls": self.n_tool_calls, "n_agent_errors": self.n_agent_errors,
+                "stopped_reason": stopped_reason, "error_message": self.error_message, **usage}
+
+
+def load_candidate(path: str):
+    """The candidate module's AgentHarness class (a HandbookRunner subclass)."""
+    import importlib.util
+    d = os.path.dirname(os.path.abspath(path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec = importlib.util.spec_from_file_location("candidate", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    cls = getattr(mod, "AgentHarness", None)
+    if cls is None or not isinstance(cls, type) or not issubclass(cls, HandbookRunner):
+        raise TypeError(f"{path}: AgentHarness must be a class subclassing HandbookRunner")
+    return cls
+
+
+def main() -> None:
+    # This file runs as __main__ and the candidate imports it as `handbook_runner`:
+    # alias the running module so both see one HandbookRunner class.
+    sys.modules.setdefault("handbook_runner", sys.modules[__name__])
+    args = sys.argv[1:]
+    candidate = None
+    if "--candidate" in args:
+        i = args.index("--candidate")
+        candidate = args[i + 1]
+        del args[i:i + 2]
+    if len(args) != 2:
+        _log("usage: handbook_runner.py <config.json> <output.json> [--candidate <module.py>]")
+        sys.exit(2)
+    config_path, output_path = args
+    with open(config_path) as f:
+        config = json.load(f)
+    try:
+        cls = load_candidate(candidate) if candidate else HandbookRunner
+        result = cls(config).run()
+    except Exception as e:
+        result = {"agent_id": "openhands_sdk", "model": config.get("model"), "final_output": "",
+                  "n_tool_calls": 0, "stopped_reason": "error", "error_message": str(e),
+                  "input_tokens": None, "output_tokens": None, "cache_tokens": None, "cost_usd": None}
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    with open(output_path, "w") as f:
+        json.dump(result, f, indent=2)
+    _log(f"wrote trajectory to {output_path} (stopped_reason={result.get('stopped_reason')}, "
+         f"n_tool_calls={result.get('n_tool_calls')})")
+
+
+if __name__ == "__main__":
+    main()
