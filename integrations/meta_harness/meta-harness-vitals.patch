+def validate_candidate(name, import_path):
+    """Run --validate-agent in a fresh interpreter. Returns True if valid."""
+    result = run_cmd(
+        [sys.executable, str(Path(__file__)), "--validate-agent", import_path],
+        cwd=str(EVOLVE_DIR),
+        timeout=900,
+    )
+    if result.returncode == 0 and "OK" in result.stdout:
+        print(f"    {_dim(result.stdout.strip().splitlines()[-1][:160])}")
+        return True
+    print(f"  {_red('validation FAIL')}: {name}")
+    for line in ((result.stderr or "") + (result.stdout or "")).strip().splitlines()[-3:]:
+        print(f"    {_dim(line[:300])}")
+    return False
